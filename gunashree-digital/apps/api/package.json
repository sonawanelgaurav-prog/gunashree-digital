{
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate --schema ../../packages/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema ../../packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema ../../packages/database/prisma/schema.prisma",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "prisma": "^6.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0"
  }
}